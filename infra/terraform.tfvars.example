# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and customize values

# AWS Configuration
aws_region  = "us-east-1"
environment = "dev"
project_name = "go-postgresql-dev"

# VPC Configuration
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# EKS Configuration
eks_cluster_version      = "1.28"
eks_node_instance_types  = ["t3.medium"]
eks_node_desired_size    = 2
eks_node_min_size        = 1
eks_node_max_size        = 4

# RDS Configuration
db_instance_class           = "db.t3.micro"
db_allocated_storage        = 20
db_engine_version           = "16.1"
db_name                     = "postgresqldb"
db_username                 = "dbadmin"
db_backup_retention_period  = 7
db_multi_az                 = false

# IMPORTANT: Set db_password via environment variable for security
# Option 1: Environment variable (recommended)
#   export TF_VAR_db_password="your_secure_password"
#
# Option 2: Command line (for testing only)
#   terraform apply -var="db_password=your_password"
#
# Option 3: Uncomment and set here (NOT RECOMMENDED for production)
# db_password = "ChangeMe123!"

# Additional Tags (optional)
additional_tags = {
  Department = "Engineering"
  CostCenter = "DevOps"
}
